# --- Crash logging (optioneel) ---
# Zonder deze var logt de app enkel naar stdout (verdwijnt met Railway's
# log-rotatie). Aanmaken op sentry.io, project type "FastAPI".
SENTRY_DSN=

# --- Resend afzenderadres (verplicht, require_env) ---
# Vaste waarde in productie: contact@kotklusser.be
SENDER_EMAIL=

# --- Basis-URL voor e-maillinks: bevestiging, e-mailwijziging, pand-koppelcodes (verplicht, require_env) ---
# Lokaal: http://localhost:3000 — productie: https://kotklusser.be
APP_URL=
